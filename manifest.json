{
    "$schema": "https://www.schemastore.org/chrome-manifest.json",
    "name": "YouTube Auto Speed",
    "description": "Automatically speeds up YouTube when nobody is speaking",
    "version": "0.0.1",
    "manifest_version": 3,
    "action": {
        "default_popup": "dist/popup.html",
        "default_title": "YouTube Auto Speed",
        "default_icon": "assets/auto-speed.png"
    },
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["dist/interceptor.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["dist/content.js"],
            "css": ["dist/content.css"],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["storage"]
}
