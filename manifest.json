{
    "$schema": "https://www.schemastore.org/chrome-manifest.json",
    "name": "YouTube Auto Speed",
    "description": "Automatically speeds up YouTube when nobody is speaking",
    "version": "0.0.1",
    "manifest_version": 3,
    "action": {},
    "content_scripts": [
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["dist/interceptor.js"],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["dist/content.js"],
            "run_at": "document_idle"
        }
    ]
}
